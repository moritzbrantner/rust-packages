{
  "name": "text-linguistics-app",
  "version": "0.1.0",
  "description": "React app for text-linguistics: language, lemma, POS, entity, event, relation, topic, and style inspection.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "node ../../node_modules/.bun/node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "../../node_modules/.bun/node_modules/typescript/bin/tsc -p tsconfig.json && node ../../node_modules/.bun/node_modules/vite/bin/vite.js build",
    "typecheck": "../../node_modules/.bun/node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "format": "bunx oxfmt --write src",
    "preview": "node ../../node_modules/.bun/node_modules/vite/bin/vite.js preview --host 0.0.0.0"
  },
  "dependencies": {
    "@mb-rust/text-linguistics-wasm": "workspace:*",
    "@vitejs/plugin-react": "^5.1.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^6.0.2"
  }
}
