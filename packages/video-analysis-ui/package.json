{
  "name": "@video-analysis/ui",
  "version": "0.1.0",
  "description": "React and TailwindCSS components for video-analysis Rust package results.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js",
      "default": "./dist/data/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    },
    "./detectors": {
      "types": "./dist/detectors/index.d.ts",
      "import": "./dist/detectors/index.js",
      "default": "./dist/detectors/index.js"
    },
    "./ffmpeg": {
      "types": "./dist/ffmpeg/index.d.ts",
      "import": "./dist/ffmpeg/index.js",
      "default": "./dist/ffmpeg/index.js"
    },
    "./ingest": {
      "types": "./dist/ingest/index.d.ts",
      "import": "./dist/ingest/index.js",
      "default": "./dist/ingest/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js",
      "default": "./dist/models/index.js"
    },
    "./package-surface": {
      "types": "./dist/package-surface/index.d.ts",
      "import": "./dist/package-surface/index.js",
      "default": "./dist/package-surface/index.js"
    },
    "./output": {
      "types": "./dist/output/index.d.ts",
      "import": "./dist/output/index.js",
      "default": "./dist/output/index.js"
    },
    "./split": {
      "types": "./dist/split/index.d.ts",
      "import": "./dist/split/index.js",
      "default": "./dist/split/index.js"
    },
    "./use-cases": {
      "types": "./dist/use-cases/index.d.ts",
      "import": "./dist/use-cases/index.js",
      "default": "./dist/use-cases/index.js"
    },
    "./tailwind-content": {
      "types": "./dist/tailwind-content.d.ts",
      "import": "./dist/tailwind-content.js",
      "default": "./dist/tailwind-content.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest --run --environment jsdom src",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^27.0.1",
    "typescript": "^6.0.2",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@moritzbrantner/ui": "^0.5.2"
  }
}
