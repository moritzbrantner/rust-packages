{
  "name": "@moritzbrantner/video-analysis-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "prototypes/web/*"
  ],
  "scripts": {
    "dev": "bun run web:dev",
    "test": "bash -lc 'RUST_TEST_THREADS=\"${RUST_TEST_THREADS:-${TEST_MAX_WORKERS:-2}}\" cargo test --jobs \"${CARGO_BUILD_JOBS:-${TEST_MAX_WORKERS:-2}}\" --workspace --lib --tests' && bun run ui:test:unit && bun run web:test:unit && bun run web:test:api",
    "verify": "scripts/check.sh",
    "preflight": "scripts/check-preflight.sh",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && bun run ui:typecheck && bun run web:typecheck",
    "format": "cargo fmt --all",
    "format:check": "cargo fmt --all --check",
    "build": "cargo build --workspace && bun run ui:build && bun run web:build",
    "hygiene": "scripts/check_repo_hygiene.sh",
    "hygiene:generated": "scripts/check_generated_artifacts.sh",
    "snapshot:check": "scripts/check_generated_snapshots.sh",
    "progress:write": "python3 scripts/audit_crate_progress.py --write",
    "progress:check": "python3 scripts/audit_crate_progress.py --check",
    "progress:touched": "python3 scripts/audit_crate_progress.py --changed --base ${BASE_REF:-origin/main}",
    "progress:test": "python3 scripts/test_audit_crate_progress.py",
    "setup:colmap-video": "scripts/setup_colmap_test_video.sh",
    "check": "scripts/check.sh",
    "bench:native": "python3 scripts/run_native_benches.py",
    "bench:native:no-run": "python3 scripts/run_native_benches.py --no-run",
    "bench": "bun run bench:native",
    "ui:build": "bun run --cwd packages/video-analysis-ui build",
    "ui:typecheck": "bun run --cwd packages/video-analysis-ui typecheck",
    "ui:test": "bun run --cwd packages/video-analysis-ui test",
    "ui:test:unit": "bun run --cwd packages/video-analysis-ui test:unit",
    "ui:test:e2e": "bun run --cwd packages/video-analysis-ui test:e2e",
    "web:dev": "bun run --cwd prototypes/web/video-analysis-web dev",
    "web:build": "bun run --cwd prototypes/web/video-analysis-web build",
    "web:build:pages": "bun run --cwd prototypes/web/video-analysis-web build:pages",
    "web:typecheck": "bun run --cwd prototypes/web/video-analysis-web typecheck",
    "web:test": "bun run --cwd prototypes/web/video-analysis-web test",
    "web:test:unit": "bun run --cwd prototypes/web/video-analysis-web test:unit",
    "web:test:api": "bun run --cwd prototypes/web/video-analysis-web test:api",
    "web:test:e2e": "bun run --cwd prototypes/web/video-analysis-web test:e2e"
  },
  "devDependencies": {
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005"
  }
}
