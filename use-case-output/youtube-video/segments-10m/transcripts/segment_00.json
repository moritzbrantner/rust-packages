ech_prob": 0.007922304794192314}, {"id": 46, "seek": 33422, "start": 338.22, "end": 339.22, "text": " Take it away.", "tokens": [50564, 3664, 309, 1314, 13, 50614], "temperature": 0.0, "avg_logprob": -0.2316964519910576, "compression_ratio": 1.5291479820627802, "no_speech_prob": 0.007922304794192314}, {"id": 47, "seek": 33422, "start": 339.22, "end": 341.22, "text": " Next, what have you got?", "tokens": [50614, 3087, 11, 437, 362, 291, 658, 30, 50714], "temperature": 0.0, "avg_logprob": -0.2316964519910576, "compression_ratio": 1.5291479820627802, "no_speech_prob": 0.007922304794192314}, {"id": 48, "seek": 33422, "start": 341.22, "end": 344.22, "text": " Well, I've got a talking donkey.", "tokens": [50714, 1042, 11, 286, 600, 658, 257, 1417, 34834, 13, 50864], "temperature": 0.0, "avg_logprob": -0.2316964519910576, "compression_ratio": 1.5291479820627802, "no_speech_prob": 0.007922304794192314}, {"id": 49, "seek": 33422, "start": 344.22, "end": 348.22, "text": " Right, well, that's good for ten shillings, if you can prove it.", "tokens": [50864, 1779, 11, 731, 11, 300, 311, 665, 337, 2064, 402, 373, 1109, 11, 498, 291, 393, 7081, 309, 13, 51064], "temperature": 0.0, "avg_logprob": -0.2316964519910576, "compression_ratio": 1.5291479820627802, "no_speech_prob": 0.007922304794192314}, {"id": 50, "seek": 33422, "start": 348.22, "end": 351.22, "text": " Go ahead, little fella.", "tokens": [51064, 1037, 2286, 11, 707, 49820, 13, 51214], "temperature": 0.0, "avg_logprob": -0.2316964519910576, "compression_ratio": 1.5291479820627802, "no_speech_prob": 0.007922304794192314}, {"id": 51, "seek": 33422, "start": 353.22, "end": 354.22, "text": " Well.", "tokens": [51314, 1042, 13, 51364], "temperature": 0.0, "avg_logprob": -0.2316964519910576, "compression_ratio": 1.5291479820627802, "no_speech_prob": 0.007922304794192314}, {"id": 52, "seek": 33422, "start": 354.22, "end": 357.22, "text": " Oh, he's just, he's just a little nervous.", "tokens": [51364, 876, 11, 415, 311, 445, 11, 415, 311, 445, 257, 707, 6296, 13, 51514], "temperature": 0.0, "avg_logprob": -0.2316964519910576, "compression_ratio": 1.5291479820627802, "no_speech_prob": 0.007922304794192314}, {"id": 53, "seek": 33422, "start": 357.22, "end": 359.22, "text": " He's really quite a shot-a-box.", "tokens": [51514, 634, 311, 534, 1596, 257, 3347, 12, 64, 12, 4995, 13, 51614], "temperature": 0.0, "avg_logprob": -0.2316964519910576, "compression_ratio": 1.5291479820627802, "no_speech_prob": 0.007922304794192314}, {"id": 54, "seek": 33422, "start": 359.22, "end": 360.22, "text": " Talk to one of those.", "tokens": [51614, 8780, 281, 472, 295, 729, 13, 51664], "temperature": 0.0, "avg_logprob": -0.2316964519910576, "compression_ratio": 1.5291479820627802, "no_speech_prob": 0.007922304794192314}, {"id": 55, "seek": 33422, "start": 360.22, "end": 362.22, "text": " That's it, I've heard enough.", "tokens": [51664, 663, 311, 309, 11, 286, 600, 2198, 1547, 13, 51764], "temperature": 0.0, "avg_logprob": -0.2316964519910576, "compression_ratio": 1.5291479820627802, "no_speech_prob": 0.007922304794192314}, {"id": 56, "seek": 36222, "start": 362.22, "end": 363.22, "text": " Guards.", "tokens": [50364, 2694, 2287, 13, 50414], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 57, "seek": 36222, "start": 363.22, "end": 364.22, "text": " No, no, he talks.", "tokens": [50414, 883, 11, 572, 11, 415, 6686, 13, 50464], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 58, "seek": 36222, "start": 364.22, "end": 365.22, "text": " He does.", "tokens": [50464, 634, 775, 13, 50514], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 59, "seek": 36222, "start": 366.22, "end": 367.22, "text": " I can talk.", "tokens": [50564, 286, 393, 751, 13, 50614], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 60, "seek": 36222, "start": 367.22, "end": 368.22, "text": " I love to talk.", "tokens": [50614, 286, 959, 281, 751, 13, 50664], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 61, "seek": 36222, "start": 368.22, "end": 371.22, "text": " When the talk needs something, you have a thought.", "tokens": [50664, 1133, 264, 751, 2203, 746, 11, 291, 362, 257, 1194, 13, 50814], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 62, "seek": 36222, "start": 372.22, "end": 374.22, "text": " Get her out of my sight.", "tokens": [50864, 3240, 720, 484, 295, 452, 7860, 13, 50964], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 63, "seek": 36222, "start": 374.22, "end": 375.22, "text": " No, no, I swear.", "tokens": [50964, 883, 11, 572, 11, 286, 11902, 13, 51014], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 64, "seek": 36222, "start": 381.22, "end": 383.22, "text": " Hey, I can fly.", "tokens": [51314, 1911, 11, 286, 393, 3603, 13, 51414], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 65, "seek": 36222, "start": 383.22, "end": 384.22, "text": " He can fly.", "tokens": [51414, 634, 393, 3603, 13, 51464], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 66, "seek": 36222, "start": 384.22, "end": 385.22, "text": " He can talk.", "tokens": [51464, 634, 393, 751, 13, 51514], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 67, "seek": 36222, "start": 385.22, "end": 386.22, "text": " That's right, fool.", "tokens": [51514, 663, 311, 558, 11, 7979, 13, 51564], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 68, "seek": 36222, "start": 386.22, "end": 387.22, "text": " None.", "tokens": [51564, 14492, 13, 51614], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 69, "seek": 36222, "start": 387.22, "end": 389.22, "text": " Flying talking donkey.", "tokens": [51614, 34287, 1417, 34834, 13, 51714], "temperature": 0.0, "avg_logprob": -0.17151386298022223, "compression_ratio": 1.5506329113924051, "no_speech_prob": 0.015426934696733952}, {"id": 70, "seek": 38922, "start": 389.22, "end": 394.22, "text": " You may have seen a house fly, maybe even a soup fly,", "tokens": [50364, 509, 815, 362, 1612, 257, 1782, 3603, 11, 1310, 754, 257, 7884, 3603, 11, 50614], "temperature": 0.0, "avg_logprob": -0.25529049060962816, "compression_ratio": 1.4666666666666666, "no_speech_prob": 0.001181740895844996}, {"id": 71, "seek": 38922, "start": 394.22, "end": 397.22, "text": " but I bet you ain't never seen a donkey fly.", "tokens": [50614, 457, 286, 778, 291, 7862, 380, 1128, 1612, 257, 34834, 3603, 13, 50764], "temperature": 0.0, "avg_logprob": -0.25529049060962816, "compression_ratio": 1.4666666666666666, "no_speech_prob": 0.001181740895844996}, {"id": 72, "seek": 38922, "start": 397.22, "end": 398.22, "text": " Aha!", "tokens": [50764, 27448, 0, 50814], "temperature": 0.0, "avg_logprob": -0.25529049060962816, "compression_ratio": 1.4666666666666666, "no_speech_prob": 0.001181740895844996}, {"id": 73, "seek": 38922, "start": 398.22, "end": 399.22, "text": " Uh-oh.", "tokens": [50814, 4019, 12, 1445, 13, 50864], "temperature": 0.0, "avg_logprob": -0.25529049060962816, "compression_ratio": 1.4666666666666666, "no_speech_prob": 0.001181740895844996}, {"id": 74, "seek": 38922, "start": 400.22, "end": 401.22, "text": " Ouch!", "tokens": [50914, 27217, 0, 50964], "temperature": 0.0, "avg_logprob": -0.25529049060962816, "compression_ratio": 1.4666666666666666, "no_speech_prob": 0.001181740895844996}, {"id": 75, "seek": 38922, "start": 401.22, "end": 402.22, "text": " See, Tim.", "tokens": [50964, 3008, 11, 7172, 13, 51014], "temperature": 0.0, "avg_logprob": -0.25529049060962816, "compression_ratio": 1.4666666666666666, "no_speech_prob": 0.001181740895844996}, {"id": 76, "seek": 38922, "start": 404.22, "end": 405.22, "text": " Hey, hey, hey!", "tokens": [51114, 1911, 11, 4177, 11, 4177, 0, 51164], "temperature": 0.0, "avg_logprob": -0.25529049060962816, "compression_ratio": 1.4666666666666666, "no_speech_prob": 0.001181740895844996}, {"id": 77, "seek": 38922, "start": 405.22, "end": 406.22, "text": " Hey, hey, hey!", "tokens": [51164, 1911, 11, 4177, 11, 4177, 0, 51214], "temperature": 0.0, "avg_logprob": -0.25529049060962816, "compression_ratio": 1.4666666666666666, "no_speech_prob": 0.001181740895844996}, {"id": 78, "seek": 38922, "start": 408.22, "end": 409.22, "text": " Why are you running?", "tokens": [51314, 1545, 366, 291, 2614, 30, 51364], "temperature": 0.0, "avg_logprob": -0.25529049060962816, "compression_ratio": 1.4666666666666666, "no_speech_prob": 0.001181740895844996}, {"id": 79, "seek": 38922, "start": 410.22, "end": 411.22, "text": " Why are you running?", "tokens": [51414, 1545, 366, 291, 2614, 30, 51464], "temperature": 0.0, "avg_logprob": -0.25529049060962816, "compression_ratio": 1.4666666666666666, "no_speech_prob": 0.001181740895844996}, {"id": 80, "seek": 41922, "start": 419.22, "end": 428.22, "text": " You there, ogre?", "tokens": [50364, 509, 456, 11, 5360, 265, 30, 50814], "temperature": 0.0, "avg_logprob": -0.16507693926493328, "compression_ratio": 1.2681159420289856, "no_speech_prob": 0.0034100681077688932}, {"id": 81, "seek": 41922, "start": 428.22, "end": 429.22, "text": " Aye.", "tokens": [50814, 13377, 13, 50864], "temperature": 0.0, "avg_logprob": -0.16507693926493328, "compression_ratio": 1.2681159420289856, "no_speech_prob": 0.0034100681077688932}, {"id": 82, "seek": 41922, "start": 429.22, "end": 432.22, "text": " By the order of Lord Farquad.", "tokens": [50864, 3146, 264, 1668, 295, 3257, 9067, 358, 345, 13, 51014], "temperature": 0.0, "avg_logprob": -0.16507693926493328, "compression_ratio": 1.2681159420289856, "no_speech_prob": 0.0034100681077688932}, {"id": 83, "seek": 41922, "start": 432.22, "end": 436.22, "text": " I am authorized to place you both under arrest", "tokens": [51014, 286, 669, 28312, 281, 1081, 291, 1293, 833, 7823, 51214], "temperature": 0.0, "avg_logprob": -0.16507693926493328, "compression_ratio": 1.2681159420289856, "no_speech_prob": 0.0034100681077688932}, {"id": 84, "seek": 41922, "start": 436.22, "end": 440.22, "text": " and transport you to a resettlement facility.", "tokens": [51214, 293, 5495, 291, 281, 257, 725, 3093, 3054, 8973, 13, 51414], "temperature": 0.0, "avg_logprob": -0.16507693926493328, "compression_ratio": 1.2681159420289856, "no_speech_prob": 0.0034100681077688932}, {"id": 85, "seek": 41922, "start": 440.22, "end": 441.22, "text": " Oh, really?", "tokens": [51414, 876, 11, 534, 30, 51464], "temperature": 0.0, "avg_logprob": -0.16507693926493328, "compression_ratio": 1.2681159420289856, "no_speech_prob": 0.0034100681077688932}, {"id": 86, "seek": 41922, "start": 442.22, "end": 443.22, "text": " You and what army?", "tokens": [51514, 509, 293, 437, 7267, 30, 51564], "temperature": 0.0, "avg_logprob": -0.16507693926493328, "compression_ratio": 1.2681159420289856, "no_speech_prob": 0.0034100681077688932}, {"id": 87, "seek": 44922, "start": 450.22, "end": 455.22, "text": " Can I have a picture of you real quick?", "tokens": [50414, 1664, 286, 362, 257, 3036, 295, 291, 957, 1702, 30, 50664], "temperature": 0.0, "avg_logprob": -0.2802494594029018, "compression_ratio": 1.6625, "no_speech_prob": 0.005237164907157421}, {"id": 88, "seek": 44922, "start": 456.22, "end": 459.22, "text": " Listen, you were really, really stuck back there, man.", "tokens": [50714, 7501, 11, 291, 645, 534, 11, 534, 5541, 646, 456, 11, 587, 13, 50864], "temperature": 0.0, "avg_logprob": -0.2802494594029018, "compression_ratio": 1.6625, "no_speech_prob": 0.005237164907157421}, {"id": 89, "seek": 44922, "start": 459.22, "end": 460.22, "text": " Incredible.", "tokens": [50864, 35261, 13, 50914], "temperature": 0.0, "avg_logprob": -0.2802494594029018, "compression_ratio": 1.6625, "no_speech_prob": 0.005237164907157421}, {"id": 90, "seek": 44922, "start": 460.22, "end": 462.22, "text": " What are you talking to?", "tokens": [50914, 708, 366, 291, 1417, 281, 30, 51014], "temperature": 0.0, "avg_logprob": -0.2802494594029018, "compression_ratio": 1.6625, "no_speech_prob": 0.005237164907157421}, {"id": 91, "seek": 44922, "start": 463.22, "end": 464.22, "text": " Me?", "tokens": [51064, 1923, 30, 51114], "temperature": 0.0, "avg_logprob": -0.2802494594029018, "compression_ratio": 1.6625, "no_speech_prob": 0.005237164907157421}, {"id": 92, "seek": 44922, "start": 466.22, "end": 467.22, "text": " Well, I guess I was talking to you.", "tokens": [51214, 1042, 11, 286, 2041, 286, 390, 1417, 281, 291, 13, 51264], "temperature": 0.0, "avg_logprob": -0.2802494594029018, "compression_ratio": 1.6625, "no_speech_prob": 0.005237164907157421}, {"id": 93, "seek": 44922, "start": 467.22, "end": 470.22, "text": " Can't you tell that you were really grabbed by those guards?", "tokens": [51264, 1664, 380, 291, 980, 300, 291, 645, 534, 18607, 538, 729, 17652, 30, 51414], "temperature": 0.0, "avg_logprob": -0.2802494594029018, "compression_ratio": 1.6625, "no_speech_prob": 0.005237164907157421}, {"id": 94, "seek": 44922, "start": 470.22, "end": 471.22, "text": " I thought there was all that.", "tokens": [51414, 286, 1194, 456, 390, 439, 300, 13, 51464], "temperature": 0.0, "avg_logprob": -0.2802494594029018, "compression_ratio": 1.6625, "no_speech_prob": 0.005237164907157421}, {"id": 95, "seek": 44922, "start": 471.22, "end": 472.22, "text": " And then you shut up and, man,", "tokens": [51464, 400, 550, 291, 5309, 493, 293, 11, 587, 11, 51514], "temperature": 0.0, "avg_logprob": -0.2802494594029018, "compression_ratio": 1.6625, "no_speech_prob": 0.005237164907157421}, {"id": 96, "seek": 44922, "start": 472.22, "end": 474.22, "text": " you got to keep it like fades in the woods, man.", "tokens": [51514, 291, 658, 281, 1066, 309, 411, 32679, 294, 264, 15296, 11, 587, 13, 51614], "temperature": 0.0, "avg_logprob": -0.2802494594029018, "compression_ratio": 1.6625, "no_speech_prob": 0.005237164907157421}, {"id": 97, "seek": 44922, "start": 474.22, "end": 475.22, "text": " That was really good to see.", "tokens": [51614, 663, 390, 534, 665, 281, 536, 13, 51664], "temperature": 0.0, "avg_logprob": -0.2802494594029018, "compression_ratio": 1.6625, "no_speech_prob": 0.005237164907157421}, {"id": 98, "seek": 44922, "start": 475.22, "end": 477.22, "text": " Well, that's great, really.", "tokens": [51664, 1042, 11, 300, 311, 869, 11, 534, 13, 51764], "temperature": 0.0, "avg_logprob": -0.2802494594029018, "compression_ratio": 1.6625, "no_speech_prob": 0.005237164907157421}, {"id": 99, "seek": 47722, "start": 477.22, "end": 479.22, "text": " Man, it feels good to be free.", "tokens": [50364, 2458, 11, 309, 3417, 665, 281, 312, 1737, 13, 50464], "temperature": 0.0, "avg_logprob": -0.20111650890774196, "compression_ratio": 1.4326923076923077, "no_speech_prob": 0.003011582884937525}, {"id": 100, "seek": 47722, "start": 479.22, "end": 481.22, "text": " How about you go celebrate your freedom", "tokens": [50464, 1012, 466, 291, 352, 8098, 428, 5645, 50564], "temperature": 0.0, "avg_logprob": -0.20111650890774196, "compression_ratio": 1.4326923076923077, "no_speech_prob": 0.003011582884937525}, {"id": 101, "seek": 47722, "start": 481.22, "end": 483.22, "text": " with your own friends?", "tokens": [50564, 365, 428, 1065, 1855, 30, 50664], "temperature": 0.0, "avg_logprob": -0.20111650890774196, "compression_ratio": 1.4326923076923077, "no_speech_prob": 0.003011582884937525}, {"id": 102, "seek": 47722, "start": 485.22, "end": 487.22, "text": " Well, uh, I don't have any friends.", "tokens": [50764, 1042, 11, 2232, 11, 286, 500, 380, 362, 604, 1855, 13, 50864], "temperature": 0.0, "avg_logprob": -0.20111650890774196, "compression_ratio": 1.4326923076923077, "no_speech_prob": 0.003011582884937525}, {"id": 103, "seek": 47722, "start": 487.22, "end": 490.22, "text": " And I am not going out there by myself.", "tokens": [50864, 400, 286, 669, 406, 516, 484, 456, 538, 2059, 13, 51014], "temperature": 0.0, "avg_logprob": -0.20111650890774196, "compression_ratio": 1.4326923076923077, "no_speech_prob": 0.003011582884937525}, {"id": 104, "seek": 47722, "start": 490.22, "end": 491.22, "text": " Wait a minute.", "tokens": [51014, 3802, 257, 3456, 13, 51064], "temperature": 0.0, "avg_logprob": -0.20111650890774196, "compression_ratio": 1.4326923076923077, "no_speech_prob": 0.003011582884937525}, {"id": 105, "seek": 47722, "start": 491.22, "end": 492.22, "text": " I got a great idea.", "tokens": [51064, 286, 658, 257, 869, 1558, 13, 51114], "temperature": 0.0, "avg_logprob": -0.20111650890774196, "compression_ratio": 1.4326923076923077, "no_speech_prob": 0.003011582884937525}, {"id": 106, "seek": 47722, "start": 492.22, "end": 493.22, "text": " I'll stick with you.", "tokens": [51114, 286, 603, 2897, 365, 291, 13, 51164], "temperature": 0.0, "avg_logprob": -0.20111650890774196, "compression_ratio": 1.4326923076923077, "no_speech_prob": 0.003011582884937525}, {"id": 107, "seek": 47722, "start": 494.22, "end": 495.22, "text": " Oh, hey, track.", "tokens": [51214, 876, 11, 4177, 11, 2837, 13, 51264], "temperature": 0.0, "avg_logprob": -0.20111650890774196, "compression_ratio": 1.4326923076923077, "no_speech_prob": 0.003011582884937525}, {"id": 108, "seek": 47722, "start": 495.22, "end": 496.22, "text": " It's me, Donkey.", "tokens": [51264, 467, 311, 385, 11, 44217, 13, 51314], "temperature": 0.0, "avg_logprob": -0.20111650890774196, "compression_ratio": 1.4326923076923077, "no_speech_prob": 0.003011582884937525}, {"id": 109, "seek": 47722, "start": 496.22, "end": 499.22, "text": " I have over 155 places I can say.", "tokens": [51314, 286, 362, 670, 2119, 20, 3190, 286, 393, 584, 13, 51464], "temperature": 0.0, "avg_logprob": -0.20111650890774196, "compression_ratio": 1.4326923076923077, "no_speech_prob": 0.003011582884937525}, {"id": 110, "seek": 47722, "start": 499.22, "end": 500.22, "text": " Yeah.", "tokens": [51464, 865, 13, 51514], "temperature": 0.0, "avg_logprob": -0.20111650890774196, "compression_ratio": 1.4326923076923077, "no_speech_prob": 0.003011582884937525}, {"id": 111, "seek": 50022, "start": 500.22, "end": 501.22, "text": " Yeah.", "tokens": [50364, 865, 13, 50414], "temperature": 0.0, "avg_logprob": -0.24418111280961471, "compression_ratio": 1.3586206896551725, "no_speech_prob": 0.004615042358636856}, {"id": 112, "seek": 50022, "start": 515.22, "end": 516.22, "text": " You almost burned the hair out of my nose.", "tokens": [51114, 509, 1920, 13490, 264, 2578, 484, 295, 452, 6690, 13, 51164], "temperature": 0.0, "avg_logprob": -0.24418111280961471, "compression_ratio": 1.3586206896551725, "no_speech_prob": 0.004615042358636856}, {"id": 113, "seek": 50022, "start": 516.22, "end": 517.22, "text": " This is just like that time.", "tokens": [51164, 639, 307, 445, 411, 300, 565, 13, 51214], "temperature": 0.0, "avg_logprob": -0.24418111280961471, "compression_ratio": 1.3586206896551725, "no_speech_prob": 0.004615042358636856}, {"id": 114, "seek": 50022, "start": 519.22, "end": 520.22, "text": " It's a rotten beard.", "tokens": [51314, 467, 311, 257, 31977, 17455, 13, 51364], "temperature": 0.0, "avg_logprob": -0.24418111280961471, "compression_ratio": 1.3586206896551725, "no_speech_prob": 0.004615042358636856}, {"id": 115, "seek": 50022, "start": 520.22, "end": 522.22, "text": " I had all type of gas coming out of my butt that day.", "tokens": [51364, 286, 632, 439, 2010, 295, 4211, 1348, 484, 295, 452, 6660, 300, 786, 13, 51464], "temperature": 0.0, "avg_logprob": -0.24418111280961471, "compression_ratio": 1.3586206896551725, "no_speech_prob": 0.004615042358636856}, {"id": 116, "seek": 50022, "start": 522.22, "end": 524.22, "text": " Why are you following me?", "tokens": [51464, 1545, 366, 291, 3480, 385, 30, 51564], "temperature": 0.0, "avg_logprob": -0.24418111280961471, "compression_ratio": 1.3586206896551725, "no_speech_prob": 0.004615042358636856}, {"id": 117, "seek": 50022, "start": 526.22, "end": 527.22, "text": " I'll tell you why.", "tokens": [51664, 286, 603, 980, 291, 983, 13, 51714], "temperature": 0.0, "avg_logprob": -0.24418111280961471, "compression_ratio": 1.3586206896551725, "no_speech_prob": 0.004615042358636856}, {"id": 118, "seek": 53022, "start": 531.22, "end": 532.22, "text": " Oh.", "tokens": [50414, 876, 13, 50464], "temperature": 0.0, "avg_logprob": -0.13901142741358558, "compression_ratio": 1.518987341772152, "no_speech_prob": 0.004746447317302227}, {"id": 119, "seek": 53022, "start": 533.22, "end": 534.22, "text": " I'm all alone.", "tokens": [50514, 286, 478, 439, 3312, 13, 50564], "temperature": 0.0, "avg_logprob": -0.13901142741358558, "compression_ratio": 1.518987341772152, "no_speech_prob": 0.004746447317302227}, {"id": 120, "seek": 53022, "start": 535.22, "end": 538.22, "text": " There's no one here beside me.", "tokens": [50614, 821, 311, 572, 472, 510, 15726, 385, 13, 50764], "temperature": 0.0, "avg_logprob": -0.13901142741358558, "compression_ratio": 1.518987341772152, "no_speech_prob": 0.004746447317302227}, {"id": 121, "seek": 53022, "start": 539.22, "end": 541.22, "text": " My problems have all gone.", "tokens": [50814, 1222, 2740, 362, 439, 2780, 13, 50914], "temperature": 0.0, "avg_logprob": -0.13901142741358558, "compression_ratio": 1.518987341772152, "no_speech_prob": 0.004746447317302227}, {"id": 122, "seek": 53022, "start": 541.22, "end": 545.22, "text": " There's no one to derive me.", "tokens": [50914, 821, 311, 572, 472, 281, 28446, 385, 13, 51114], "temperature": 0.0, "avg_logprob": -0.13901142741358558, "compression_ratio": 1.518987341772152, "no_speech_prob": 0.004746447317302227}, {"id": 123, "seek": 53022, "start": 547.22, "end": 549.22, "text": " But you got to have friends.", "tokens": [51214, 583, 291, 658, 281, 362, 1855, 13, 51314], "temperature": 0.0, "avg_logprob": -0.13901142741358558, "compression_ratio": 1.518987341772152, "no_speech_prob": 0.004746447317302227}, {"id": 124, "seek": 53022, "start": 549.22, "end": 550.22, "text": " Stop singing.", "tokens": [51314, 5535, 6726, 13, 51364], "temperature": 0.0, "avg_logprob": -0.13901142741358558, "compression_ratio": 1.518987341772152, "no_speech_prob": 0.004746447317302227}, {"id": 125, "seek": 53022, "start": 550.22, "end": 552.22, "text": " It's no wonder you don't have any friends.", "tokens": [51364, 467, 311, 572, 2441, 291, 500, 380, 362, 604, 1855, 13, 51464], "temperature": 0.0, "avg_logprob": -0.13901142741358558, "compression_ratio": 1.518987341772152, "no_speech_prob": 0.004746447317302227}, {"id": 126, "seek": 53022, "start": 556.22, "end": 557.22, "text": " Wow.", "tokens": [51664, 3153, 13, 51714], "temperature": 0.0, "avg_logprob": -0.13901142741358558, "compression_ratio": 1.518987341772152, "no_speech_prob": 0.004746447317302227}, {"id": 127, "seek": 53022, "start": 557.22, "end": 559.22, "text": " Only a true friend would be that, Juliadas.", "tokens": [51714, 5686, 257, 2074, 1277, 576, 312, 300, 11, 7174, 72, 6872, 13, 51814], "temperature": 0.0, "avg_logprob": -0.13901142741358558, "compression_ratio": 1.518987341772152, "no_speech_prob": 0.004746447317302227}, {"id": 128, "seek": 55922, "start": 559.22, "end": 561.22, "text": " Listen, little donkey.", "tokens": [50364, 7501, 11, 707, 34834, 13, 50464], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 129, "seek": 55922, "start": 561.22, "end": 562.22, "text": " Take a look at me.", "tokens": [50464, 3664, 257, 574, 412, 385, 13, 50514], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 130, "seek": 55922, "start": 562.22, "end": 563.22, "text": " What am I?", "tokens": [50514, 708, 669, 286, 30, 50564], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 131, "seek": 55922, "start": 564.22, "end": 565.22, "text": " Uh...", "tokens": [50614, 4019, 485, 50664], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 132, "seek": 55922, "start": 568.22, "end": 569.22, "text": " Really, don't?", "tokens": [50814, 4083, 11, 500, 380, 30, 50864], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 133, "seek": 55922, "start": 569.22, "end": 570.22, "text": " No.", "tokens": [50864, 883, 13, 50914], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 134, "seek": 55922, "start": 570.22, "end": 571.22, "text": " I'm a fucking ogre.", "tokens": [50914, 286, 478, 257, 5546, 5360, 265, 13, 50964], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 135, "seek": 55922, "start": 571.22, "end": 575.22, "text": " You know, grab your torches and pitchforks.", "tokens": [50964, 509, 458, 11, 4444, 428, 3930, 3781, 293, 7293, 69, 1284, 82, 13, 51164], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 136, "seek": 55922, "start": 575.22, "end": 577.22, "text": " Doesn't that bother you?", "tokens": [51164, 12955, 380, 300, 8677, 291, 30, 51264], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 137, "seek": 55922, "start": 578.22, "end": 579.22, "text": " Nope.", "tokens": [51314, 12172, 13, 51364], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 138, "seek": 55922, "start": 579.22, "end": 580.22, "text": " Really?", "tokens": [51364, 4083, 30, 51414], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 139, "seek": 55922, "start": 580.22, "end": 581.22, "text": " Really, really.", "tokens": [51414, 4083, 11, 534, 13, 51464], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 140, "seek": 55922, "start": 581.22, "end": 582.22, "text": " Oh.", "tokens": [51464, 876, 13, 51514], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 141, "seek": 55922, "start": 582.22, "end": 583.22, "text": " Man, I like you.", "tokens": [51514, 2458, 11, 286, 411, 291, 13, 51564], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 142, "seek": 55922, "start": 583.22, "end": 585.22, "text": " What's your name?", "tokens": [51564, 708, 311, 428, 1315, 30, 51664], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 143, "seek": 55922, "start": 585.22, "end": 587.22, "text": " Uh, track.", "tokens": [51664, 4019, 11, 2837, 13, 51764], "temperature": 0.0, "avg_logprob": -0.1396897517213034, "compression_ratio": 1.3820224719101124, "no_speech_prob": 0.0033225691877305508}, {"id": 144, "seek": 58722, "start": 587.22, "end": 588.22, "text": " Got that sort of...", "tokens": [50364, 5803, 300, 1333, 295, 485, 50414], "temperature": 0.0, "avg_logprob": -0.1684491877653161, "compression_ratio": 1.191304347826087, "no_speech_prob": 0.015589182265102863}, {"id": 145, "seek": 58722, "start": 588.22, "end": 590.22, "text": " I don't care what people think about me, vibe.", "tokens": [50414, 286, 500, 380, 1127, 437, 561, 519, 466, 385, 11, 14606, 13, 50514], "temperature": 0.0, "avg_logprob": -0.1684491877653161, "compression_ratio": 1.191304347826087, "no_speech_prob": 0.015589182265102863}, {"id": 146, "seek": 58722, "start": 590.22, "end": 592.22, "text": " And I respect that.", "tokens": [50514, 400, 286, 3104, 300, 13, 50614], "temperature": 0.0, "avg_logprob": -0.1684491877653161, "compression_ratio": 1.191304347826087, "no_speech_prob": 0.015589182265102863}, {"id": 147, "seek": 58722, "start": 595.22, "end": 597.22, "text": " Aw, jeez.", "tokens": [50764, 6381, 11, 1506, 4371, 13, 50864], "temperature": 0.0, "avg_logprob": -0.1684491877653161, "compression_ratio": 1.191304347826087, "no_speech_prob": 0.015589182265102863}, {"id": 148, "seek": 58722, "start": 597.22, "end": 599.22, "text": " Who'd want to live in a place like that?", "tokens": [50864, 2102, 1116, 528, 281, 1621, 294, 257, 1081, 411, 300, 30, 50964], "temperature": 0.0, "avg_logprob": -0.1684491877653161, "compression_ratio": 1.191304347826087, "no_speech_prob": 0.015589182265102863}], "language": "en"}