, 445, 360, 300, 30, 50514], "temperature": 0.0, "avg_logprob": -0.17902325221470425, "compression_ratio": 1.644859813084112, "no_speech_prob": 0.3168719708919525}, {"id": 109, "seek": 53820, "start": 541.2, "end": 545.2, "text": " You gotta warn somebody before you just crack one off, my mouth was open and everything", "tokens": [50514, 509, 3428, 12286, 2618, 949, 291, 445, 6226, 472, 766, 11, 452, 4525, 390, 1269, 293, 1203, 50714], "temperature": 0.0, "avg_logprob": -0.17902325221470425, "compression_ratio": 1.644859813084112, "no_speech_prob": 0.3168719708919525}, {"id": 110, "seek": 53820, "start": 545.2, "end": 549.2, "text": " Believe me, donkey, and then me, you'd be dead", "tokens": [50714, 21486, 385, 11, 34834, 11, 293, 550, 385, 11, 291, 1116, 312, 3116, 50914], "temperature": 0.0, "avg_logprob": -0.17902325221470425, "compression_ratio": 1.644859813084112, "no_speech_prob": 0.3168719708919525}, {"id": 111, "seek": 53820, "start": 551.2, "end": 554.2, "text": " It's brimstone, we're getting close", "tokens": [51014, 467, 311, 738, 332, 11243, 11, 321, 434, 1242, 1998, 51164], "temperature": 0.0, "avg_logprob": -0.17902325221470425, "compression_ratio": 1.644859813084112, "no_speech_prob": 0.3168719708919525}, {"id": 112, "seek": 53820, "start": 554.2, "end": 557.2, "text": " Yeah, right brimstone, don't be talking about it, brimstone, I know what I smell", "tokens": [51164, 865, 11, 558, 738, 332, 11243, 11, 500, 380, 312, 1417, 466, 309, 11, 738, 332, 11243, 11, 286, 458, 437, 286, 4316, 51314], "temperature": 0.0, "avg_logprob": -0.17902325221470425, "compression_ratio": 1.644859813084112, "no_speech_prob": 0.3168719708919525}, {"id": 113, "seek": 53820, "start": 557.2, "end": 560.2, "text": " It wasn't no brimstone, didn't come off no stone, neither", "tokens": [51314, 467, 2067, 380, 572, 738, 332, 11243, 11, 994, 380, 808, 766, 572, 7581, 11, 9662, 51464], "temperature": 0.0, "avg_logprob": -0.17902325221470425, "compression_ratio": 1.644859813084112, "no_speech_prob": 0.3168719708919525}, {"id": 114, "seek": 56820, "start": 568.2, "end": 570.2, "text": " Some time later", "tokens": [50364, 2188, 565, 1780, 50464], "temperature": 0.4, "avg_logprob": -0.3642663804311601, "compression_ratio": 1.3357142857142856, "no_speech_prob": 0.00693250447511673}, {"id": 115, "seek": 56820, "start": 578.2, "end": 582.2, "text": " Sure, it's big enough, but look at the location", "tokens": [50864, 4894, 11, 309, 311, 955, 1547, 11, 457, 574, 412, 264, 4914, 51064], "temperature": 0.4, "avg_logprob": -0.3642663804311601, "compression_ratio": 1.3357142857142856, "no_speech_prob": 0.00693250447511673}, {"id": 116, "seek": 56820, "start": 586.2, "end": 592.2, "text": " Uh, Shrek, remember when you said that, uh, that, that ogres have layers?", "tokens": [51264, 4019, 11, 1160, 20012, 11, 1604, 562, 291, 848, 300, 11, 2232, 11, 300, 11, 300, 5360, 495, 362, 7914, 30, 51564], "temperature": 0.4, "avg_logprob": -0.3642663804311601, "compression_ratio": 1.3357142857142856, "no_speech_prob": 0.00693250447511673}, {"id": 117, "seek": 56820, "start": 592.2, "end": 594.2, "text": " Oh, I?", "tokens": [51564, 876, 11, 286, 30, 51664], "temperature": 0.4, "avg_logprob": -0.3642663804311601, "compression_ratio": 1.3357142857142856, "no_speech_prob": 0.00693250447511673}, {"id": 118, "seek": 56820, "start": 594.2, "end": 596.2, "text": " Well, I have a bit of a confession to make", "tokens": [51664, 1042, 11, 286, 362, 257, 857, 295, 257, 29154, 281, 652, 51764], "temperature": 0.4, "avg_logprob": -0.3642663804311601, "compression_ratio": 1.3357142857142856, "no_speech_prob": 0.00693250447511673}, {"id": 119, "seek": 59620, "start": 596.2, "end": 600.2, "text": " Donkeys don't have layers, we, we wear fear right out there", "tokens": [50364, 1468, 18847, 500, 380, 362, 7914, 11, 321, 11, 321, 3728, 4240, 558, 484, 456, 50564], "temperature": 0.0, "avg_logprob": -0.15003703700171578, "compression_ratio": 0.9833333333333333, "no_speech_prob":